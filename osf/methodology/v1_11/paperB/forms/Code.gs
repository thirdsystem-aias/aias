/**
 * SVA sentiment exercise (Sentiment Paper B) — Google Apps Script. r2, 2026-11-11, AIAS runner
 * (branch v1.11-paperB; r0/r1 of 2026-11-10 in _runner_tmp/sva_labels/apps_script). r2 changes: the
 * STATEMENT block is generated from statement/statement_exercise_doc.md by
 * lock/paperB_lock_v1_11.py --sync; the four questions and their options are the wording of
 * guide page 1 (guide/STUDENT_GUIDE_v1_11_paperB.md); the tone parser accepts the guide's minus sign.
 * CODE ONLY: nobody has run this. Pablo runs it in his own Google account; the runner never does.
 *
 * Setup (about 5 minutes, after sign-ups close and make_packets.py has been re-run with the real N):
 *  1. In Google Drive: New > Google Sheets. File > Import > Upload packets/packets_all.csv >
 *     "Replace current sheet". Rename that tab to: items   (packets from make_packets_v1_11_paperB.py)
 *     (Contains pseudonymous IDs R01.. only. Never import the sign-up responses or the name key here.)
 *  2. In that sheet: Extensions > Apps Script. Paste this file over Code.gs. Fill CONFIG. Save.
 *  3. Run buildSignupForm() once (before the invite). It makes a STANDALONE form; its responses
 *     (names, emails) stay in that form and never enter this sheet.
 *  4. Run testBuildOne() and open the test form it logs: check one long item and one short item.
 *     Delete the test form from Drive afterwards.
 *  5. Run buildLabelForms(). It stops before Google's 6-minute limit; run it again until the log says
 *     "All N forms built". The tracker tab then lists each student's form link.
 *  6. Send each link yourself (see emails). Fill "date_sent" in the tracker.
 *  7. To check progress, and after the due date: run collectLabels(). It writes the "labels" tab
 *     (one row per student x item) and updates "submitted" in the tracker.
 *  8. After the cut-off: run closeLabelForms().
 */

const CONFIG = {
  GUIDE_URL: '',        // link to the two-page student guide as PDF (Drive, "anyone with the link can view")
  VIDEO_URL: '',        // link to the 10-minute recorded intro
  DUE_TEXT: 'Friday, December 4',   // timeline: invite 11/13, sign-ups close 11/20, forms 11/23, due 12/4
  FOLDER_ID: '',        // optional Drive folder for the forms; blank = My Drive root
  TEXT_CHUNK: 3500,     // long answers are split across several text blocks of at most this many characters
};

// The plain-language statement, word for word from the exercise doc (Emily's condition, Nov 10).
// Bold markers are dropped because Google Forms descriptions are plain text; the words are identical.
// BEGIN STATEMENT (generated by lock/paperB_lock_v1_11.py --sync; do not edit by hand)
const STATEMENT = [
  'What this is. An optional exercise for the Class of 2027, before our course starts. It is not graded and has no effect on your course or standing. If you skip it, you still join the discussion on April 21.',
  'What you do. You watch a short video, then read about 55 short AI answers about brands. For each one, you mark the tone toward one named brand in a Google Form. It takes about 45 minutes, on your own time, by December 4.',
  'What your labels are for. They are part of my independent research program, Third System. The research checks whether an AI can judge the tone toward a brand the way people do. Your labels are the human benchmark.',
  'Who sees them. I see your responses. Before any analysis, your name is replaced with a code (for example R07), and only I keep the key. I use AI tools (Claude) to help with the analysis, using the coded data only.',
  "What gets published. The coded labels, with no names or emails, go into a public research archive (OSF). Summary results appear in a research paper and on thirdsystem.ai, and may appear in Third System reports and talks. You are never named, unless you tick the box asking to be thanked by name in the paper's acknowledgments.",
  'Your choice. Taking part is voluntary. You can stop at any time. You can withdraw your labels until December 18 by emailing me at pablou@pablou.com, with no questions asked. After that date, the coded data may already be published.',
  'Questions. Email me, or ask Emily Weiland in the program office.',
].join('\n\n');
// END STATEMENT

// Questions and answer options: the wording of guide page 1 (labels in bold there), unchanged.
// Analysis parses the leading number of TONE; keep these strings unchanged once forms exist.
const Q_TITLES = ['1. What\'s the tone toward the brand?', '2. Praise and criticism?',
                  '3. Where does the judgment come from?', '4. How sure?'];
const TONE = ['+2 · Strongly favorable', '+1 · Favorable', '0 · Neutral or balanced', '−1 · Unfavorable',
              '−2 · Strongly unfavorable', 'Not about this brand'];
const BOTH = ['Yes', 'No'];
const SOURCE = ['No judgment', "The AI's own voice", 'Quoted sources', 'Both'];
const SURE = ['Sure', 'Not sure'];
const ITEM_COLS = ['student_id', 'position', 'n_items', 'item_id', 'target_brand', 'category',
                   'question', 'text_type', 'text'];
const TIME_BUDGET_MS = 4 * 60 * 1000;   // start no new form after 4 minutes (Google's limit is 6)

// ---------------------------------------------------------------------------------------------
// Sign-up form (standalone; names and emails stay in this form's own responses)
// ---------------------------------------------------------------------------------------------
function buildSignupForm() {
  const form = FormApp.create('SVA sentiment exercise: sign up (optional)');
  form.setDescription(STATEMENT)
      .setCollectEmail(false)
      .setAllowResponseEdits(false)
      .setShowLinkToRespondAgain(false)
      .setPublishingSummary(false)
      .setConfirmationMessage('Thank you for signing up. Your personal form link, the video and the ' +
                              'guide will come by email from Pablo.');
  form.addTextItem().setTitle('Your name').setRequired(true);
  form.addTextItem().setTitle('Your SVA email').setRequired(true)
      .setValidation(FormApp.createTextValidation().requireTextIsEmail()
      .setHelpText('Please enter an email address.').build());
  form.addCheckboxItem().setTitle('Consent')
      .setChoiceValues(["I've read this and agree to take part"]).setRequired(true);
  form.addCheckboxItem().setTitle('Acknowledgments (optional)')
      .setHelpText('Leave unticked to stay anonymous ("students of the SVA MPS Branding program").')
      .setChoiceValues(["Please thank me by name in the paper's acknowledgments"]).setRequired(false);
  moveToFolder_(form.getId());
  Logger.log('Sign-up form: ' + form.getPublishedUrl() + '\nEdit: ' + form.getEditUrl());
}

// ---------------------------------------------------------------------------------------------
// Labelling forms: one per student, from the "items" tab (packets_all.csv)
// ---------------------------------------------------------------------------------------------
function readItems_() {
  const sh = SpreadsheetApp.getActive().getSheetByName('items');
  if (!sh) throw new Error('No tab named "items": import packets_all.csv first.');
  const v = sh.getDataRange().getValues();
  const head = v[0].map(String);
  if (head.join('|') !== ITEM_COLS.join('|')) throw new Error('items columns differ: ' + head.join(','));
  const by = {};
  v.slice(1).forEach(r => {
    const o = {}; ITEM_COLS.forEach((c, i) => o[c] = r[i]);
    o.position = Number(o.position); o.n_items = Number(o.n_items);
    o.text = String(o.text); o.question = String(o.question);
    (by[o.student_id] = by[o.student_id] || []).push(o);
  });
  Object.keys(by).forEach(s => {
    const it = by[s].sort((a, b) => a.position - b.position);
    it.forEach((o, i) => {
      if (o.position !== i + 1 || o.n_items !== it.length) throw new Error('packet ' + s + ' positions broken');
    });
  });
  return by;
}

function sheet_(name, header) {
  const ss = SpreadsheetApp.getActive();
  let sh = ss.getSheetByName(name);
  if (!sh) { sh = ss.insertSheet(name); sh.appendRow(header); sh.setFrozenRows(1); }
  return sh;
}

const TRACKER_COLS = ['student_id', 'n_items', 'status', 'form_id', 'form_url', 'edit_url', 'built_at',
                      'date_sent', 'submitted', 'responses', 'first_response_at'];
const MAP_COLS = ['student_id', 'form_id', 'form_item_id', 'item_id', 'position', 'field'];

function chunks_(text, max) {
  const out = []; let cur = '';
  text.split(/(\n)/).forEach(part => {
    if ((cur + part).length > max && cur) { out.push(cur); cur = ''; }
    while (part.length > max) { out.push(part.slice(0, max)); part = part.slice(max); }
    cur += part;
  });
  if (cur.trim()) out.push(cur);
  return out;
}

function moveToFolder_(id) {
  if (CONFIG.FOLDER_ID) DriveApp.getFileById(id).moveTo(DriveApp.getFolderById(CONFIG.FOLDER_ID));
}

function buildOneForm_(sid, items, titleSuffix, onCreate) {
  const n = items.length;
  const form = FormApp.create('SVA sentiment exercise: packet ' + sid + (titleSuffix || ''));
  if (onCreate) onCreate(form);           // tracker row marked "building" before any item is added
  const intro = [
    'Your packet has ' + n + ' items. Please finish by ' + CONFIG.DUE_TEXT + '.',
    'Before you start: watch the 10-minute video (' + (CONFIG.VIDEO_URL || 'link in the email') +
      ') and keep the guide open (' + (CONFIG.GUIDE_URL || 'PDF in the email') + ').',
    'Work alone, and don\'t compare answers with classmates before April 21. Don\'t look the brands up. ' +
      'Your own opinion of a brand doesn\'t count, only what the text says. There are no right answers to guess.',
    'Once you move to the next item, please don\'t go back to change an answer. Your answers are only sent ' +
      'when you press Submit on the last page, so keep this tab open until then (Google Forms may not save ' +
      'a half-finished form).',
    '— How your labels will be used —', STATEMENT,
  ].join('\n\n');
  form.setDescription(intro)
      .setProgressBar(true)
      .setCollectEmail(false)
      .setAllowResponseEdits(false)
      .setShowLinkToRespondAgain(false)
      .setPublishingSummary(false)
      .setShuffleQuestions(false)
      .setConfirmationMessage('Thank you. Your labels are in. See you on April 21.');
  const map = [];
  const fid = form.getId();
  items.forEach(o => {
    const b = String(o.target_brand);
    form.addPageBreakItem()
        .setTitle('Item ' + o.position + ' of ' + n + '  ·  target brand: ' + b)
        .setHelpText('TARGET BRAND: ' + b + '\nCATEGORY: ' + o.category +
                     '\nQUESTION THE ASSISTANT WAS ANSWERING: ' + o.question +
                     '\nTEXT TYPE: ' + o.text_type + '\n\nGuide: ' + (CONFIG.GUIDE_URL || 'see email') +
                     '   ·   item code ' + o.item_id);
    chunks_(o.text, CONFIG.TEXT_CHUNK).forEach((c, i) => {
      form.addSectionHeaderItem().setTitle(i === 0 ? 'TEXT' : 'TEXT (continued)').setHelpText(c);
    });
    const q = [
      ['tone', form.addMultipleChoiceItem().setTitle(Q_TITLES[0]).setHelpText('Target brand: ' + b)
                   .setChoiceValues(TONE)],
      ['both', form.addMultipleChoiceItem().setTitle(Q_TITLES[1]).setHelpText('Target brand: ' + b)
                   .setChoiceValues(BOTH)],
      ['source', form.addMultipleChoiceItem().setTitle(Q_TITLES[2]).setHelpText('Target brand: ' + b)
                     .setChoiceValues(SOURCE)],
      ['sure', form.addMultipleChoiceItem().setTitle(Q_TITLES[3]).setChoiceValues(SURE)],
      ['comment', form.addTextItem().setTitle('Comment (optional): one line if something was unclear')],
    ];
    q.forEach(([field, it]) => {
      if (field !== 'comment') it.setRequired(true);
      map.push([o.student_id, fid, it.getId(), o.item_id, o.position, field]);
    });
  });
  moveToFolder_(fid);
  return { form: form, map: map };
}

function buildLabelForms() {
  const t0 = Date.now();
  const by = readItems_();
  const students = Object.keys(by).sort();
  const tr = sheet_('tracker', TRACKER_COLS);
  const mp = sheet_('map', MAP_COLS);
  const rows = tr.getDataRange().getValues().slice(1);
  const status = {}; rows.forEach((r, i) => status[r[0]] = { row: i + 2, status: r[2], formId: r[3] });
  let built = 0;
  for (const sid of students) {
    if (status[sid] && status[sid].status === 'built') { built++; continue; }
    if (Date.now() - t0 > TIME_BUDGET_MS) break;
    if (status[sid] && status[sid].status === 'building' && status[sid].formId) {
      DriveApp.getFileById(status[sid].formId).setTrashed(true);   // partial form from a timed-out run
      deleteMapRows_(mp, status[sid].formId);
      tr.deleteRow(status[sid].row);
      return buildLabelForms();                                    // row numbers changed: start over
    }
    const res = buildOneForm_(sid, by[sid], '', f => {
      tr.appendRow([sid, by[sid].length, 'building', f.getId(), f.getPublishedUrl(), f.getEditUrl(),
                    new Date(), '', 'no', 0, '']);
      SpreadsheetApp.flush();
    });
    mp.getRange(mp.getLastRow() + 1, 1, res.map.length, MAP_COLS.length).setValues(res.map);
    tr.getRange(tr.getLastRow(), 3).setValue('built');
    SpreadsheetApp.flush();
    built++;
  }
  Logger.log(built === students.length ? 'All ' + built + ' forms built.'
                                        : built + ' of ' + students.length + ' built. Run buildLabelForms() again.');
}

function deleteMapRows_(mp, formId) {
  const v = mp.getDataRange().getValues();
  for (let i = v.length - 1; i >= 1; i--) if (v[i][1] === formId) mp.deleteRow(i + 1);
}

/** Builds R01's packet as a throwaway test form (not tracked). Delete it from Drive after checking. */
function testBuildOne() {
  const by = readItems_();
  const sid = Object.keys(by).sort()[0];
  const res = buildOneForm_(sid, by[sid], ' (TEST, delete me)');
  Logger.log('Test form: ' + res.form.getPublishedUrl());
}

// ---------------------------------------------------------------------------------------------
// Collect all responses into one long "labels" tab (coded IDs only; no names, no emails)
// Rule (pre-registration draft): a student's FIRST submitted response counts; later ones are
// counted in the tracker and ignored.
// ---------------------------------------------------------------------------------------------
const LABEL_COLS = ['student_id', 'position', 'item_id', 'tone', 'valence', 'refers_to_brand', 'both',
                    'mixed', 'source', 'evaluative', 'sure', 'comment', 'submitted_at'];

function collectLabels() {
  const ss = SpreadsheetApp.getActive();
  const tr = ss.getSheetByName('tracker');
  const mv = ss.getSheetByName('map').getDataRange().getValues().slice(1);
  const key = {};                                   // form_item_id -> [student, item_id, position, field]
  mv.forEach(r => key[String(r[2])] = [r[0], r[3], r[4], r[5]]);
  const tv = tr.getDataRange().getValues();
  const out = [];
  for (let i = 1; i < tv.length; i++) {
    if (tv[i][2] !== 'built') continue;
    const form = FormApp.openById(tv[i][3]);
    const resp = form.getResponses().sort((a, b) => a.getTimestamp() - b.getTimestamp());
    tr.getRange(i + 1, 9, 1, 3).setValues([[resp.length ? 'yes' : 'no', resp.length,
                                             resp.length ? resp[0].getTimestamp() : '']]);
    if (!resp.length) continue;
    const r0 = resp[0];
    const rec = {};                                 // item_id -> row object
    r0.getItemResponses().forEach(ir => {
      const k = key[String(ir.getItem().getId())];
      if (!k) return;
      const o = rec[k[1]] = rec[k[1]] || { student_id: k[0], item_id: k[1], position: k[2] };
      o[k[3]] = String(ir.getResponse());
    });
    Object.values(rec).sort((a, b) => a.position - b.position).forEach(o => {
      const notAbout = o.tone === 'Not about this brand';
      const m = /^([+-]?\d)/.exec((o.tone || '').replace('\u2212', '-'));
      out.push([o.student_id, o.position, o.item_id, o.tone || '', notAbout ? '' : (m ? Number(m[1]) : ''),
                o.tone ? !notAbout : '', o.both || '', o.both ? o.both === 'Yes' : '', o.source || '',
                o.source ? o.source.indexOf('No judgment') !== 0 : '', o.sure || '', o.comment || '',
                r0.getTimestamp()]);
    });
  }
  let sh = ss.getSheetByName('labels');
  if (sh) sh.clear(); else sh = ss.insertSheet('labels');
  sh.getRange(1, 1, 1, LABEL_COLS.length).setValues([LABEL_COLS]);
  if (out.length) sh.getRange(2, 1, out.length, LABEL_COLS.length).setValues(out);
  sh.setFrozenRows(1);
  Logger.log(out.length + ' label rows written.');
}

function closeLabelForms() {
  const tv = SpreadsheetApp.getActive().getSheetByName('tracker').getDataRange().getValues();
  for (let i = 1; i < tv.length; i++) if (tv[i][3]) FormApp.openById(tv[i][3]).setAcceptingResponses(false)
      .setCustomClosedFormMessage('This exercise is closed. Thank you.');
  Logger.log('Closed.');
}
