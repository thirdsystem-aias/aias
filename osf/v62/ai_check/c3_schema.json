{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIAS v0.62 AI check C3 reply (coding of C1 against the English source; DEVIATIONS Entry 2)",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "description": "exactly one entry per item id sent, no other ids",
      "items": {
        "type": "object",
        "required": ["id", "code", "reason"],
        "properties": {
          "id": {"type": "string"},
          "code": {"enum": ["equivalent", "minor drift", "meaning change"]},
          "reason": {"type": "string"}
        }
      }
    }
  }
}
